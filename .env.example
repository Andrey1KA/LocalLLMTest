DATABASE_URL="file:./dev.db"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Локальная модель: Ollama на арендованном сервере, с этого компьютера через туннель
# ssh -L 11434:127.0.0.1:11434 user@server
# Тогда ключ можно оставить пустым. Имя модели взять из `ollama list`.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen3:30b
# Контекст для локальной модели. Пусто — 4096, чтобы окно Qwen не заняло всю карту.
# LLM_NUM_CTX=4096
# TTL кэша ответов LLM на сервере (мс), по умолчанию 300000; 0 — не кэшировать
LLM_CACHE_TTL_MS=300000
# Лимит LLM-запросов с одного клиента (IP / x-forwarded-for) за окно; 0 — отключить
LLM_RATE_LIMIT_MAX=30
LLM_RATE_LIMIT_WINDOW_MS=60000
# 1 — писать в stdout сведения о токенах (usage) после ответов OpenAI
LLM_LOG_USAGE=
